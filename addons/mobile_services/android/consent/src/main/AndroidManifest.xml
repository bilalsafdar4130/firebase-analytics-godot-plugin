<?xml version="1.0" encoding="utf-8"?>
<!--
  How Godot finds this plugin at runtime.

  The engine scans the merged manifest for <meta-data> entries whose name starts
  with "org.godotengine.plugin.v2." — the suffix is the singleton name GDScript
  reaches the plugin by, and the value is the class to instantiate. Both halves
  are placeholders filled from build.gradle.kts, so the name Godot looks for
  cannot drift from the class that implements it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.${godotPluginName}"
            android:value="${godotPluginClass}" />
    </application>
</manifest>
